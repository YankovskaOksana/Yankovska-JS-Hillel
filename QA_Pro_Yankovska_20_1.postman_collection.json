    {
      "name": "EXPENSES (Creates an expense)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "function randomLiters(min = 2, max = 150) {\r",
              "  const value = min + Math.random() * (max - min);\r",
              "  return Number(value.toFixed(1));\r",
              "}\r",
              "\r",
              "function nextMileage(carId, minStep = 1, maxStep = 500) {\r",
              "  const key = `lastMileage_${carId}`;\r",
              "  const last = Number(pm.collectionVariables.get(key) || 0);\r",
              "\r",
              "  const step = Math.floor(Math.random() * (maxStep - minStep + 1)) + minStep;\r",
              "  const next = last + step;\r",
              "\r",
              "  pm.collectionVariables.set(key, next);\r",
              "  return next;\r",
              "}\r",
              "\r",
              "const carId = Number(pm.collectionVariables.get(\"carsId\") || pm.collectionVariables.get(\"carId\"));\r",
              "if (!carId) throw new Error('Missing \"carsId\" (or \"carId\")');\r",
              "\r",
              "const liters = randomLiters(2, 150);\r",
              "pm.collectionVariables.set(\"liters\", liters);\r",
              "\r",
              "const mileage = nextMileage(carId, 1, 500);\r",
              "pm.collectionVariables.set(\"mileage\", mileage);\r",
              "\r",
              "console.log(\"carId:\", carId);\r",
              "console.log(\"liters:\", liters);\r",
              "console.log(\"mileage:\", mileage);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const carId = +pm.collectionVariables.get(\"carsId\") || +pm.collectionVariables.get(\"carId\");\r",
              "const k = `prevMileage_${carId}`;\r",
              "const cur = +pm.collectionVariables.get(\"mileage\");\r",
              "const prev = +pm.collectionVariables.get(k) || 0;\r",
              "\r",
              "pm.test(\"mileage increases\", () => pm.expect(cur).to.be.above(prev));\r",
              "pm.collectionVariables.set(k, cur);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
