    {
      "name": "USERS_Password (Changes user's password)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "function genPassword(min = 8, max = 15) {\r",
              "  const chars = \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\";\r",
              "  const len = Math.floor(Math.random() * (max - min + 1)) + min;\r",
              "  const rule = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)[A-Za-z\\d]{8,15}$/;\r",
              "\r",
              "  let pass;\r",
              "  do {\r",
              "    pass = Array.from({ length: len }, () => chars[Math.floor(Math.random() * chars.length)]).join(\"\");\r",
              "  } while (!rule.test(pass));\r",
              "\r",
              "  return pass;\r",
              "}\r",
              "\r",
              "const oldPassword = String(pm.collectionVariables.get(\"password\") || \"\").trim();\r",
              "const userId = String(pm.collectionVariables.get(\"userId\") || \"\").trim();\r",
              "\r",
              "if (!oldPassword) throw new Error('Missing \"password\" (old password)');\r",
              "if (!userId) throw new Error('Missing \"userId\" (save it after signup/signin first)');\r",
              "\r",
              "const newPassword = genPassword();\r",
              "pm.collectionVariables.set(\"NEWpassword\", newPassword);\r",
              "\r",
              "\r",
              "console.log(\"userId:\", userId);\r",
              "console.log(\"NEWpassword:\", newPassword);\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();\r",
              "\r",
              "pm.test(\"Status code is 200\", () => {\r",
              "  pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test('Response status is \"ok\"', () => {\r",
              "  pm.expect(json.status).to.eql(\"ok\");\r",
              "});\r",
              "\r",
              "pm.test(\"userId exists\", () => {\r",
              "  pm.expect(json.data).to.have.property(\"userId\");\r",
              "});\r",
              "\r",
              "if (pm.response.code === 200 && json.status === \"ok\") {\r",
              "  pm.collectionVariables.set(\"password\", pm.collectionVariables.get(\"NEWpassword\"));\r",
              "  console.log(\"password updated\");\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
