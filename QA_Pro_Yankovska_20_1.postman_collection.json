      "name": "CARS (Creates new car)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const carJsonData = pm.response.json();\r",
              "const carId = carJsonData.data.id;\r",
              "\r",
              "\r",
              "console.log(\"has brandId:\", pm.variables.has(\"brandId\"));\r",
              "console.log(\"has modelId:\", pm.variables.has(\"modelId\"));\r",
              "console.log(\"has mileage:\", pm.variables.has(\"mileage\"));\r",
              "\r",
              "pm.test(\"Status code is 201\", () => {\r",
              "  pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "const json = pm.response.json();\r",
              "\r",
              "pm.test('status is \"ok\"', () => pm.expect(json.status).to.eql(\"ok\"));\r",
              "\r",
              "pm.test(\"data.id exists\", () => {\r",
              "  pm.expect(json.data).to.have.property(\"id\");\r",
              "});\r",
              "\r",
              "pm.collectionVariables.set(\"carsId\", json.data.id);\r",
              "\r",
              "pm.test(\"brand/model/mileage match variables (if set)\", () => {\r",
              "  const brandId = pm.variables.get(\"brandId\");\r",
              "  const modelId = pm.variables.get(\"modelId\");\r",
              "  const mileage = pm.variables.get(\"mileage\");\r",
              "\r",
              "  if (brandId) pm.expect(Number(json.data.carBrandId)).to.eql(Number(brandId));\r",
              "  if (modelId) pm.expect(Number(json.data.carModelId)).to.eql(Number(modelId));\r",
              "  if (mileage) pm.expect(Number(json.data.mileage)).to.eql(Number(mileage));\r",
              "});\r",
              "\r",
              "pm.collectionVariables.set(\"carId\", carId);\r",
              "console.log(\"carId:\", carId);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "function randomBrandId() {\r",
              "    const brandsStr = pm.collectionVariables.get(\"brands\")\r",
              "    const brandsObj = JSON.parse(brandsStr);\r",
              "    const list = brandsObj.data;\r",
              "    const randomItem = list[Math.floor(Math.random() * list.length)];\r",
              "\r",
              "    return randomItem.id; \r",
              "}\r",
              "\r",
              "function randomModelId(brandId) {\r",
              "    const modelsStr = pm.collectionVariables.get(\"models\")\r",
              "    const modelsObj = JSON.parse(modelsStr);\r",
              "    const list = modelsObj.data;\r",
              "    const filtered = list.filter(m => m.carBrandId === Number(brandId));\r",
              "    const randomItem = filtered[Math.floor(Math.random() * filtered.length)];\r",
              "\r",
              "    return randomItem.id; \r",
              "}\r",
              "\r",
              "function randomMileage() {\r",
              "    return Math.floor(Math.random() * 10) + 10\r",
              "}\r",
              "\r",
              "const brandId = randomBrandId()\r",
              "pm.collectionVariables.set(\"brandId\", brandId)\r",
              "console.log(brandId)\r",
              "\r",
              "const modelId = randomModelId(brandId)\r",
              "pm.collectionVariables.set(\"modelId\", modelId)\r",
              "console.log(modelId)\r",
              "\r",
              "const mileage = randomMileage()\r",
              "pm.collectionVariables.set(\"mileage\", mileage)\r",
              "console.log(mileage)"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
