  "item": [
    {
      "name": "AUTH_SIGNUP validation loop",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const defaultRunTargets = [",
              "  \"https://qauto.forstudy.space/api\",",
              "  \"https://qauto2.forstudy.space/api\"",
              "];",
              "",
              "if (!pm.collectionVariables.get(\"runTargets\")) {",
              "  pm.collectionVariables.set(\"runTargets\", JSON.stringify(defaultRunTargets));",
              "}",
              "",
              "let runIndex = Number(pm.collectionVariables.get(\"runIndex\"));",
              "if (Number.isNaN(runIndex) || runIndex < 0) {",
              "  runIndex = 0;",
              "  pm.collectionVariables.set(\"runIndex\", runIndex);",
              "}",
              "",
              "const runTargets = JSON.parse(pm.collectionVariables.get(\"runTargets\"));",
              "const baseUrlApi = runTargets[runIndex];",
              "pm.collectionVariables.set(\"baseUrlApi\", baseUrlApi);",
              "",
              "const minLen = 2;",
              "const maxLen = 20;",
              "",
              "function randomName(min = 2, max = 20) {",
              "  const letters = \"abcdefghijklmnopqrstuvwxyz\";",
              "  const len = Math.floor(Math.random() * (max - min + 1)) + min;",
              "  let name = \"\";",
              "  for (let i = 0; i < len; i++) {",
              "    name += letters[Math.floor(Math.random() * letters.length)];",
              "  }",
              "  return name;",
              "}",
              "",
              "function genPassword(min = 8, max = 15) {",
              "  const chars = \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\";",
              "  const len = Math.floor(Math.random() * (max - min + 1)) + min;",
              "  const rule = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)[A-Za-z\\d]{8,15}$/;",
              "  let pass = \"\";",
              "  do {",
              "    pass = Array.from({ length: len }, () => chars[Math.floor(Math.random() * chars.length)]).join(\"\");",
              "  } while (!rule.test(pass));",
              "  return pass;",
              "}",
              "",
              "const randomEmail = `testemail+${Math.floor(Math.random() * 1000000)}@test.com`;",
              "const validName = randomName(minLen, maxLen);",
              "const validLastName = randomName(minLen, maxLen);",
              "const validPassword = genPassword();",
              "",
              "pm.collectionVariables.set(\"email\", randomEmail);",
              "pm.collectionVariables.set(\"firstName\", validName);",
              "pm.collectionVariables.set(\"lastName\", validLastName);",
              "pm.collectionVariables.set(\"password\", validPassword);",
              "",
              "const validationCases = [",
              "  {",
              "    testName: \"AUTH_SIGNUP (empty name)\",",
              "    requestBody: {",
              "      name: \"\",",
              "      lastName: validLastName,",
              "      email: randomEmail,",
              "      password: validPassword,",
              "      repeatPassword: validPassword",
              "    },",
              "    expectedCode: 400,",
              "    expectedMessage: pm.collectionVariables.get(\"emptyNameError\")",
              "  },",
              "  {",
              "    testName: \"AUTH_SIGNUP (invalid last name<2)\",",
              "    requestBody: {",
              "      name: validName,",
              "      lastName: \"R\",",
              "      email: randomEmail,",
              "      password: validPassword,",
              "      repeatPassword: validPassword",
              "    },",
              "    expectedCode: 400,",
              "    expectedMessage: pm.collectionVariables.get(\"invalidLastNameError\")",
              "  },",
              "  {",
              "    testName: \"AUTH_SIGNUP (invalid password<8)\",",
              "    requestBody: {",
              "      name: validName,",
              "      lastName: validLastName,",
              "      email: randomEmail,",
              "      password: \"jkio34\",",
              "      repeatPassword: validPassword",
              "    },",
              "    expectedCode: 400,",
              "    expectedMessage: pm.collectionVariables.get(\"invalidPasswordError\")",
              "  },",
              "  {",
              "    testName: \"AUTH_SIGNUP (the second password is different from the original one)\",",
              "    requestBody: {",
              "      name: validName,",
              "      lastName: validLastName,",
              "      email: randomEmail,",
              "      password: validPassword,",
              "      repeatPassword: \"fjklehdd5\"",
              "    },",
              "    expectedCode: 400,",
              "    expectedMessage: pm.collectionVariables.get(\"passwordMismatchError\")",
              "  },",
              "  {",
              "    testName: \"AUTH_SIGNUP (password does not contain a capital letter)\",",
              "    requestBody: {",
              "      name: validName,",
              "      lastName: validLastName,",
              "      email: randomEmail,",
              "      password: \"lkson9rj\",",
              "      repeatPassword: \"lkson9rj\"",
              "    },",
              "    expectedCode: 400,",
              "    expectedMessage: pm.collectionVariables.get(\"invalidPasswordError\")",
              "  }",
              "];",
              "",
              "pm.collectionVariables.set(\"validationCases\", JSON.stringify(validationCases));",
              "",
              "let validationIndex = Number(pm.collectionVariables.get(\"validationIndex\"));",
              "if (Number.isNaN(validationIndex) || validationIndex < 0) {",
              "  validationIndex = 0;",
              "}",
              "",
              "const currentCase = validationCases[validationIndex];",
              "pm.collectionVariables.set(\"currentValidationIndex\", validationIndex);",
              "pm.collectionVariables.set(\"currentValidationCase\", JSON.stringify(currentCase));",
              "pm.variables.set(\"signupValidationBody\", JSON.stringify(currentCase.requestBody));",
              "console.log(`Run target: ${baseUrlApi}`);",
              "console.log(`Validation case: ${currentCase.testName}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const jsonData = pm.response.json();",
              "const currentCase = JSON.parse(pm.collectionVariables.get(\"currentValidationCase\"));",
              "const validationCases = JSON.parse(pm.collectionVariables.get(\"validationCases\"));",
              "let validationIndex = Number(pm.collectionVariables.get(\"currentValidationIndex\"));",
              "",
              "pm.test(currentCase.testName + \" - status code\", function () {",
              "  pm.expect(pm.response.code).to.eql(currentCase.expectedCode);",
              "});",
              "",
              "pm.test(currentCase.testName + \" - message\", function () {",
              "  pm.expect(jsonData.message).to.eql(currentCase.expectedMessage);",
              "});",
              "",
              "validationIndex += 1;",
              "pm.collectionVariables.set(\"validationIndex\", validationIndex);",
              "",
              "if (validationIndex < validationCases.length) {",
              "  pm.execution.setNextRequest(\"AUTH_SIGNUP validation loop\");",
              "} else {",
              "  pm.collectionVariables.unset(\"validationIndex\");",
              "  pm.collectionVariables.unset(\"currentValidationIndex\");",
              "  pm.collectionVariables.unset(\"currentValidationCase\");",
              "  pm.execution.setNextRequest(\"AUTH_SIGNUP\");",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{{signupValidationBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
