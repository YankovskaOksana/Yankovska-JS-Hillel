          ],
          "path": [
            "auth",
            "signup"
          ]
        }
      },
      "response": []
    },
    {
      "name": "AUTH_SIGNUP",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const email = `testemail+${Math.random()}@test.com`;\r",
              "pm.collectionVariables.set(\"email\", email);\r",
              "\r",
              "const value = String(pm.collectionVariables.get(\"email\") || \"\").trim();\r",
              "const re = /^[^\\s@]+@[^\\s@]+\\.[A-Za-z]{2,}$/;\r",
              "\r",
              "if (!value) throw new Error(\"Email is missing\");\r",
              "if (!re.test(value)) throw new Error(`Invalid email format: \"${value}\"`);\r",
              "\r",
              "pm.collectionVariables.set(\"email\", value);\r",
              "console.log(value);\r",
              "\r",
              "const minLen = 2;\r",
              "const maxLen = 20;\r",
              "function randomName(min = 2, max = 20) {\r",
              "  const letters = \"abcdefghijklmnopqrstuvwxyz\";\r",
              "  const len = Math.floor(Math.random() * (max - min + 1)) + min;\r",
              "\r",
              "  let name = \"\";\r",
              "  for (let i = 0; i < len; i++) {\r",
              "    name += letters[Math.floor(Math.random() * letters.length)];\r",
              "  }\r",
              "  return name.trim().replace(/\\s+/g, \"\");\r",
              "}\r",
              "const firstName = randomName(minLen, maxLen);\r",
              "\r",
              "pm.collectionVariables.set(\"firstName\", firstName);\r",
              "console.log(firstName);\r",
              "\r",
              "const lastName = randomName(minLen, maxLen);\r",
              "pm.collectionVariables.set(\"lastName\", lastName)\r",
              "console.log(lastName)\r",
              "\r",
              "function genPassword(min = 8, max = 15) {\r",
              "  const chars = \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\";\r",
              "  const len = Math.floor(Math.random() * (max - min + 1)) + min;\r",
              "\r",
              "  const rule = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)[A-Za-z\\d]{8,15}$/;\r",
              "\r",
              "  let pass;\r",
              "  do {\r",
              "    pass = Array.from({ length: len }, () => chars[Math.floor(Math.random() * chars.length)]).join(\"\");\r",
              "  } while (!rule.test(pass));\r",
              "\r",
              "  return pass;\r",
              "}\r",
              "\r",
              "const password = genPassword();\r",
              "pm.collectionVariables.set(\"password\", password)\r",
              "console.log(password);\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();\r",
              "pm.collectionVariables.set(\"userId\", jsonData.data.userId);\r",
              "\r",
              "\r",
              "var schema = {\r",
              "  \"type\": \"object\",\r",
              "  \"properties\": {\r",
              "    \"status\": {\r",
              "      \"type\": \"string\"\r",
              "    },\r",
              "    \"data\": {\r",
              "      \"type\": \"object\",\r",
              "      \"properties\": {\r",
              "        \"userId\": {\r",
              "          \"type\": \"integer\"\r",
              "        },\r",
              "        \"photoFilename\": {\r",
              "          \"type\": \"string\"\r",
              "        },\r",
              "        \"distanceUnits\": {\r",
              "          \"type\": \"string\"\r",
              "        },\r",
              "        \"currency\": {\r",
              "          \"type\": \"string\"\r",
              "        }\r",
              "      },\r",
              "      \"required\": [\r",
              "        \"userId\",\r",
              "        \"photoFilename\",\r",
              "        \"distanceUnits\",\r",
              "        \"currency\"\r",
              "      ]\r",
              "    }\r",
              "  },\r",
              "  \"required\": [\r",
              "    \"status\",\r",
              "    \"data\"\r",
              "  ]\r",
              "}\r",
              "pm.test(\"schema\", ()=> {\r",
              "  pm.response.to.have.jsonSchema(schema);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
