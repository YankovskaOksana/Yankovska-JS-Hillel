              "pm.test(\"Status code is 200 or 204\", () => {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
              "});",
              "",
              "if (pm.response.code !== 204) {",
              "  const json = pm.response.json?.();",
              "  if (json) {",
              "    pm.test('status is \"ok\"', () => pm.expect(json.status).to.eql(\"ok\"));",
              "  }",
              "}",
              "",
              "pm.test(\"sid cookie is missing after delete\", () => {",
              "  const sid = pm.cookies.get(\"sid\");",
              "  pm.expect(!sid).to.be.true;",
              "});",
              "",
              "const runTargets = JSON.parse(pm.collectionVariables.get(\"runTargets\") || \"[]\");",
              "let runIndex = Number(pm.collectionVariables.get(\"runIndex\"));",
              "",
              "if (!Number.isNaN(runIndex) && runIndex + 1 < runTargets.length) {",
              "  runIndex += 1;",
              "  pm.collectionVariables.set(\"runIndex\", runIndex);",
              "  pm.collectionVariables.set(\"baseUrlApi\", runTargets[runIndex]);",
              "  pm.collectionVariables.unset(\"validationIndex\");",
              "  pm.collectionVariables.unset(\"currentValidationIndex\");",
              "  pm.collectionVariables.unset(\"currentValidationCase\");",
              "  pm.collectionVariables.unset(\"userId\");",
              "  pm.collectionVariables.unset(\"carId\");",
              "  pm.collectionVariables.unset(\"carsId\");",
              "  pm.collectionVariables.unset(\"expensesId\");",
              "  pm.execution.setNextRequest(\"AUTH_SIGNUP validation loop\");",
              "} else {",
              "  pm.collectionVariables.unset(\"runIndex\");",
              "  pm.collectionVariables.unset(\"validationIndex\");",
              "  pm.collectionVariables.unset(\"currentValidationIndex\");",
              "  pm.collectionVariables.unset(\"currentValidationCase\");",
              "  pm.execution.setNextRequest(null);",
              "}"
            ],
            "packages": {},
            "requests": {}
          }
        }
