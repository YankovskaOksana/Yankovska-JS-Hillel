              "\r",
              "const minDate = new Date(today.getFullYear() - maxAge, today.getMonth(), today.getDate());\r",
              "const maxDate = new Date(today.getFullYear() - minAge, today.getMonth(), today.getDate());\r",
              "\r",
              "if (parsed < minDate || parsed > maxDate) {\r",
              "  throw new Error(`dateBirth is out of range (${maxAge}..${minAge} years): \"${value}\"`);\r",
              "}\r",
              "\r",
              "console.log(value);\r",
              "\r",
              "\r",
              "const countries = [\r",
              "  \"Ukraine\",\r",
              "  \"Spain\",\r",
              "  \"Poland\",\r",
              "  \"Germany\",\r",
              "  \"France\",\r",
              "  \"Italy\",\r",
              "  \"United Kingdom\",\r",
              "  \"United States\",\r",
              "  \"Canada\",\r",
              "  \"Mexico\"\r",
              "];\r",
              "\r",
              "const country = countries[Math.floor(Math.random() * countries.length)];\r",
              "\r",
              "pm.collectionVariables.set(\"country\", country);\r",
              "console.log(country);"
