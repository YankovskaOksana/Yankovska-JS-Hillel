        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();\r",
              "\r",
              "console.log(\"has email:\", pm.variables.has(\"email\"));\r",
              "console.log(\"has password:\", pm.variables.has(\"password\"));\r",
              "\r",
              "pm.test(\"Status code is 200 or 400\", () => {\r",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 400]);\r",
              "});\r",
              "\r",
